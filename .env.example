# Copy this file to .env and add credentials locally. Never commit .env.
WEATHER_PROVIDER=openmeteo
TOMORROW_API_KEY=
OPENWEATHER_API_KEY=
IMD_API_URL=
IMD_API_KEY=
WEATHER_TIMEOUT_SECONDS=8
WEATHER_REFRESH_INTERVAL_SECONDS=3600

# Optional cloud persistence. SQLite is used when these are empty.
SUPABASE_URL=
# Not used by the current API; service-role key is server-side only.
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 8 API runtime. Leave blank to use the public ECMWF endpoint and local SQLite.
OPEN_METEO_ECMWF_URL=https://api.open-meteo.com/v1/ecmwf
WEATHER_TIMEOUT_SECONDS=20
APP_TIMEZONE=Asia/Kolkata
JK_DISASTER_SQLITE_PATH=data/runtime/jk_disaster_demo.sqlite3

# Local API access and browser origin.
# API_KEY is not consumed by the current API; no authentication is implemented.
API_KEY=
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=65536

# Alert/resource policy. Inventory defaults to clearly labelled demo stock.
ALERT_COOLDOWN_MINUTES=120
RESOURCE_INVENTORY_MODE=demo

# Optional outbound notification credentials; delivery stays disabled by default.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TO_PHONE=
EMAIL_USER=
EMAIL_PASSWORD=
RECEIVER_EMAIL=
